{
  "info": {
    "_postman_id": "ad70de7a-e30b-4b41-9ee7-6da10891b093",
    "name": "ToneVault API",
    "description": "Requests for authentication, the public pedal catalog, authenticated pedalboard CRUD, and the rig preset workflow. Set base_url to the backend origin (for example http://localhost:8000). Login/register requests capture the response token into the token collection variable. Preset approval requires an administrator token and must be performed by an administrator other than the preset owner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "guitarist_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "guitarist_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "pedalId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "pedalboardId",
      "value": "",
      "type": "string"
    },
    {
      "key": "rigPresetId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register guitarist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set('token', body.token);",
                  "  if (body.user && body.user.email) pm.collectionVariables.set('guitarist_email', body.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ToneVault Guitarist\",\n  \"email\": \"guitarist-{{$timestamp}}@example.test\",\n  \"password\": \"{{guitarist_password}}\",\n  \"password_confirmation\": \"{{guitarist_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/register",
            "description": "Creates a regular user. Set guitarist_password before sending. A unique email is generated for each request."
          }
        },
        {
          "name": "Login guitarist (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{guitarist_email}}\",\n  \"password\": \"{{guitarist_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/login",
            "description": "Set guitarist_email and guitarist_password, then send. The returned bearer token replaces the collection token."
          }
        },
        {
          "name": "Login administrator (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/login",
            "description": "Set admin_email and admin_password for an administrator account. Use this before approve/archive requests; it replaces the token with the administrator token."
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/user"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/logout"
          }
        }
      ]
    },
    {
      "name": "Pedal catalog",
      "item": [
        {
          "name": "List pedals",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/pedals?search=BOSS&page=1",
            "description": "Public catalog endpoint. Optional query parameters include search, category, type, status, and page."
          }
        },
        {
          "name": "Get pedal filters",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/pedal-filters"
          }
        },
        {
          "name": "Get pedal",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/pedals/{{pedalId}}"
          }
        },
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/categories"
          }
        }
      ]
    },
    {
      "name": "Pedalboards",
      "item": [
        {
          "name": "List my pedalboards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/pedalboards"
          }
        },
        {
          "name": "Create pedalboard (saves ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('pedalboardId', String(body.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weekend Board\",\n  \"description\": \"A compact live setup.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/pedalboards",
            "description": "Requires guitarist authentication. Saves the returned board ID to pedalboardId."
          }
        },
        {
          "name": "Get pedalboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/pedalboards/{{pedalboardId}}"
          }
        },
        {
          "name": "Update pedalboard",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Weekend Board\",\n  \"description\": \"Updated board notes.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/pedalboards/{{pedalboardId}}"
          }
        },
        {
          "name": "Delete pedalboard",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/pedalboards/{{pedalboardId}}",
            "description": "Deletes the board identified by pedalboardId. Run after any requests that use the board."
          }
        }
      ]
    },
    {
      "name": "Rig presets workflow",
      "item": [
        {
          "name": "List my presets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/rig-presets"
          }
        },
        {
          "name": "Create Draft preset (saves ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('rigPresetId', String(body.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Studio Clean\",\n  \"pedalboard_id\": {{pedalboardId}},\n  \"description\": \"Wide clean tone.\",\n  \"amp_settings\": {\n    \"gain\": 3,\n    \"bass\": 5,\n    \"middle\": 6,\n    \"treble\": 5\n  },\n  \"guitar\": \"Fender Stratocaster\",\n  \"tuning\": \"E Standard\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/rig-presets",
            "description": "Creates a preset in Draft status. Run Create pedalboard first or replace pedalboard_id with null or an owned board ID. Saves the returned preset ID."
          }
        },
        {
          "name": "Get preset",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/rig-presets/{{rigPresetId}}"
          }
        },
        {
          "name": "Update own preset (remains Draft)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated clean tone.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/rig-presets/{{rigPresetId}}",
            "description": "Editing a Submitted or Approved preset as its owner returns it to Draft."
          }
        },
        {
          "name": "Submit Draft preset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/rig-presets/{{rigPresetId}}/submit",
            "description": "As the preset owner, transitions Draft to Submitted. The preset must be Draft."
          }
        },
        {
          "name": "Approve Submitted preset (administrator)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/rig-presets/{{rigPresetId}}/approve",
            "description": "Login as an administrator first. Transitions Submitted to Approved; the administrator cannot approve their own preset."
          }
        },
        {
          "name": "Archive preset (administrator)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/rig-presets/{{rigPresetId}}/archive",
            "description": "Login as an administrator first. Transitions a non-Archived preset to Archived."
          }
        },
        {
          "name": "Delete own non-Archived preset",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/rig-presets/{{rigPresetId}}",
            "description": "A guitarist may delete their own Draft, Submitted, or Approved preset, but not an Archived preset."
          }
        }
      ]
    }
  ]
}
